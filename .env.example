# Shared reference — copy into backend/.env and frontend/.env.local

# backend/.env
MONGODB_URI=mongodb://127.0.0.1:27017/apex
REDIS_URL=redis://127.0.0.1:6379
BIKE_DATA_PROVIDER=bikespecs
BIKESPECS_API_KEY=
BIKESPECS_API_BASE_URL=https://api.bikespecs.org
API_NINJAS_API_KEY=
API_NINJAS_API_BASE_URL=https://api.api-ninjas.com
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
