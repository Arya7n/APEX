# APEX — copy to .env and fill in local values. Never commit secrets.

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/apex

# --- Cache ---
REDIS_URL=redis://127.0.0.1:6379

# --- External bike data provider ---
BIKE_DATA_PROVIDER=bikespecs
BIKESPECS_API_KEY=
BIKESPECS_API_BASE_URL=https://api.bikespecs.org

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# --- API ---
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Media (optional, Phase 9+) ---
CLOUDINARY_URL=
AWS_S3_BUCKET=
AWS_S3_REGION=
