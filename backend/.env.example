# APEX backend

MONGODB_URI=mongodb://127.0.0.1:27017/apex
REDIS_URL=redis://127.0.0.1:6379
BIKE_DATA_PROVIDER=bikespecs
BIKESPECS_API_KEY=
BIKESPECS_API_BASE_URL=https://api.bikespecs.org
API_NINJAS_API_KEY=
API_NINJAS_API_BASE_URL=https://api.api-ninjas.com
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
